# Copy to .env (gitignored) and fill in. Loaded by hunter/run.py at startup,
# so it also works under launchd where the shell profile isn't sourced.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only needed if llm_backend: api in config.yaml:
# ANTHROPIC_API_KEY=
# Only needed if llm_backend: openai (OpenCode Zen / LiteLLM / OpenRouter / Ollama):
# LLM_API_KEY=
# Optional host-specific overrides of config.yaml (used by the Docker deploy):
# LLM_BACKEND=openai
# LLM_MODEL=deepseek-v4-flash-free,glm-5.1   # comma-separated fallback chain, primary first
# LLM_BASE_URL=https://opencode.ai/zen/v1
# RUN_INTERVAL_MINUTES=30
